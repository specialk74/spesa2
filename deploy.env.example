# Configurazione di tools/deploy-rpi.sh: copialo in deploy.env (escluso da git) e completalo.

# Utente e indirizzo del Pi, per ssh/scp (serve l'accesso con chiave, senza password)
PI_HOST=pi@raspberrypi.local
# Cartella del programma sul Pi, relativa alla home
PI_DIR=spesa-rs
# Servizi systemd da riavviare (separati da spazi) e porte su cui ascoltano, per la verifica
PI_SERVICES="spesa"
PI_PORTS="9080"
# Come compilare per il Pi: zigbuild (default) o cross (richiede Docker)
BUILDER=zigbuild
